{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/themes.php?page=ti-import",
	"preferredVersions": { "php": "8.3", "wp": "latest" },
	"features": { "networking": true },
	"login": true,
	"steps": [
		{ "step": "setSiteLanguage", "language": "it_IT" },
		{
			"step": "installPlugin",
			"pluginData": { "resource": "wordpress.org/plugins", "slug": "secure-custom-fields" },
			"options": { "activate": true }
		},
		{ "step": "activateTheme", "themeFolderName": "trentino-invest" },
		{ "step": "setSiteOptions", "options": { "blogname": "Trentino Invest", "permalink_structure": "/%postname%/" } }
	]
}
